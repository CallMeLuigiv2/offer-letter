{
  "name": "office-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone harness for the pixel office (web/src/office) until web/ has phaser + easystarjs.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "shots": "node shots.mjs",
    "rooms": "node rooms.mjs",
    "gif": "node gif.mjs",
    "check": "node check.mjs",
    "smoke": "node smoke-build.mjs"
  },
  "dependencies": {
    "easystarjs": "0.4.4",
    "phaser": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
